NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=chiikaiwa
JWT_AUDIENCE=chiikaiwa-web

# ====================================
# MongoDB local (Docker replica set)
# ====================================
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true

# ====================================
# MongoDB Atlas (shared development)
# Uncomment to use Atlas instead of local
# ====================================
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@chiikaiwa-cluster.kixshim.mongodb.net/

# Database configuration
MONGODB_DB_NAME=chiikaiwa_dev
MONGODB_MAX_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Optional: use installed mongod
# MONGOMS_SYSTEM_BINARY=C:/Program Files/MongoDB/Server/8.2/bin/mongod.exe

# LiveKit test project (server only; never use VITE_ for credentials)
LIVEKIT_URL=wss://your-test-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-test-project-api-key
LIVEKIT_API_SECRET=replace-with-test-project-api-secret

# ====================================
# Seed Data & Testing Fixtures (06 §13.1)
# ====================================
# Lưu ý: giá trị từ file .env được trim() khoảng trắng hai đầu khi nạp.
# Mọi mật khẩu đã đặt (SEED_ADMIN_PASSWORD, SEED_USER_PASSWORD) đều phải có tối thiểu 8 ký tự
# sau khi trim; seed sẽ báo lỗi và dừng trước khi ghi dữ liệu nếu ngắn hơn,
# kể cả khi tài khoản tương ứng đã tồn tại trong DB (khi đó mật khẩu không được áp dụng).
# Mật khẩu bắt buộc cho tài khoản Admin khi DB chưa có Admin (không dùng mật khẩu mặc định)
SEED_ADMIN_PASSWORD=
# Mật khẩu tùy chọn cho learnerA, learnerB, learnerC, locked. Để trống = tự sinh mật khẩu ngẫu nhiên
# (các tài khoản đó sẽ chưa đăng nhập được cho đến khi đặt lại mật khẩu).
SEED_USER_PASSWORD=
