NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=chiikaiwa
JWT_AUDIENCE=chiikaiwa-web

# ====================================
# MongoDB local (Docker replica set)
# ====================================
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true

# ====================================
# MongoDB Atlas (shared development)
# Uncomment to use Atlas instead of local
# ====================================
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@chiikaiwa-cluster.kixshim.mongodb.net/

# Database configuration
MONGODB_DB_NAME=chiikaiwa_dev
MONGODB_MAX_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Optional: use installed mongod
# MONGOMS_SYSTEM_BINARY=C:/Program Files/MongoDB/Server/8.2/bin/mongod.exe